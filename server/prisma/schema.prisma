generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id                  String         @id @default(uuid())
  code                String         @unique
  name                String
  credits             Int
  difficultyLevel     Int            @map("difficulty_level") @db.SmallInt
  avgRating           Float?         @map("avg_rating")
  ratingCount         Int            @default(0) @map("rating_count")
  description         String?
  category            CourseCategory @default(REQUIRED)
  semesterOffered     Semester[]     @default([FALL, SPRING])
  academicYear        Int?           @map("academic_year")
  academicSemester    Int?           @map("academic_semester")
  electiveGroup       String?        @map("elective_group")
  electiveSelectCount Int?           @map("elective_select_count")

  // Self-relation for prerequisites
  prerequisites     Prerequisite[] @relation("CoursePrerequisites")
  isPrerequisiteFor Prerequisite[] @relation("PrerequisiteFor")

  // Student records
  studentRecords    StudentRecord[]
  gradeAttempts     GradeAttempt[]
  ratings           CourseRating[]
  curriculumCourses CurriculumCourse[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@index([category])
  @@index([academicYear, academicSemester])
  @@index([electiveGroup])
  @@map("courses")
}

model Prerequisite {
  id             String  @id @default(uuid())
  courseId       String  @map("course_id")
  prerequisiteId String  @map("prerequisite_id")
  isCorequisite  Boolean @default(false) @map("is_corequisite")
  isStrict       Boolean @default(true) @map("is_strict")

  course       Course @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite Course @relation("PrerequisiteFor", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([courseId, prerequisiteId])
  @@index([courseId])
  @@index([prerequisiteId])
  @@map("prerequisites")
}

// Additive foundation only: legacy catalog placement/prerequisites remain active.
// Totals and source provenance can stay unknown until a curriculum is verified.
model Curriculum {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  school       String
  degree       String
  programUrl   String   @map("program_url")
  totalCredits Int?     @map("total_credits")
  isGpaPath    Boolean  @default(false) @map("is_gpa_path")
  sourceLabel  String?  @map("source_label")
  sourceUrl    String?  @map("source_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  courses        CurriculumCourse[]
  users          User[]
  requirements   CurriculumRequirement[]
  resources      SchoolResource[]
  allocationRuns SimulationAllocationRun[]
  allocationJobs SimulationAllocationJob[]

  @@map("curriculums")
}

// Membership is unique; repeated elective appearances live in placements.
model CurriculumCourse {
  id           String @id @default(uuid())
  curriculumId String @map("curriculum_id")
  courseId     String @map("course_id")

  curriculum        Curriculum               @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  course            Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  placements        CurriculumPlacement[]
  prerequisites     CurriculumPrerequisite[] @relation("CurriculumCoursePrerequisites")
  isPrerequisiteFor CurriculumPrerequisite[] @relation("CurriculumPrerequisiteFor")

  @@unique([curriculumId, courseId])
  @@index([courseId])
  @@map("curriculum_courses")
}

// Source order distinguishes occurrences, including repeated group claims.
// Blank-code/free-elective requirements live in CurriculumRequirement.
model CurriculumPlacement {
  id                  String  @id @default(uuid())
  curriculumCourseId  String  @map("curriculum_course_id")
  academicYear        Int?    @map("academic_year")
  academicSemester    Int?    @map("academic_semester")
  electiveGroup       String? @map("elective_group")
  electiveSelectCount Int?    @map("elective_select_count")
  sourceOrder         Int     @map("source_order")
  sourceLabel         String? @map("source_label")

  curriculumCourse CurriculumCourse @relation(fields: [curriculumCourseId], references: [id], onDelete: Cascade)

  @@unique([curriculumCourseId, sourceOrder])
  @@map("curriculum_placements")
}

// Uncoded requirements are preserved without inventing global Course identities.
model CurriculumRequirement {
  id               String                    @id @default(uuid())
  curriculumId     String                    @map("curriculum_id")
  kind             CurriculumRequirementKind @default(FREE_ELECTIVE)
  name             String
  credits          Int
  academicYear     Int?                      @map("academic_year")
  academicSemester Int?                      @map("academic_semester")
  sourceOrder      Int                       @map("source_order")
  sourceLabel      String?                   @map("source_label")

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@unique([curriculumId, sourceOrder])
  @@map("curriculum_requirements")
}

enum CurriculumRequirementKind {
  FREE_ELECTIVE
}

// Both endpoints must be members of the same curriculum. Preserved flags are
// provenance only: every edge remains mandatory when context readers activate.
model CurriculumPrerequisite {
  id             String  @id @default(uuid())
  curriculumId   String  @map("curriculum_id")
  courseId       String  @map("course_id")
  prerequisiteId String  @map("prerequisite_id")
  isCorequisite  Boolean @default(false) @map("is_corequisite")
  isStrict       Boolean @default(true) @map("is_strict")

  course       CurriculumCourse @relation("CurriculumCoursePrerequisites", fields: [curriculumId, courseId], references: [curriculumId, courseId], onDelete: Cascade)
  prerequisite CurriculumCourse @relation("CurriculumPrerequisiteFor", fields: [curriculumId, prerequisiteId], references: [curriculumId, courseId], onDelete: Cascade)

  @@unique([curriculumId, courseId, prerequisiteId])
  @@index([curriculumId, prerequisiteId])
  @@map("curriculum_prerequisites")
}

// Simulation configuration only; it does not represent a real offering or allocation.
model SchoolResource {
  id                    String     @id @default(uuid())
  curriculumId          String     @map("curriculum_id")
  semester              Semester
  year                  Int
  professors            Int        @default(0)
  classrooms            Int        @default(0)
  labRooms              Int        @default(0) @map("lab_rooms")
  maxStudentsPerSection Int        @default(40) @map("max_students_per_section")
  courseOverrides       Json       @default("{}") @map("course_overrides")
  revision              Int        @default(1)
  updatedBy             String?    @map("updated_by")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  curriculum            Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  updatedByUser         User?      @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([curriculumId, semester, year])
  @@map("school_resources")
}

model User {
  id                   String   @id @default(uuid())
  studentId            String   @unique @map("student_id")
  name                 String
  email                String   @unique
  password             String?
  passwordHash         String?  @map("password_hash")
  role                 UserRole @default(STUDENT)
  major                String?
  enrollmentYear       Int?     @map("enrollment_year")
  targetGraduationYear Int?     @map("target_graduation_year")
  curriculumId         String?  @map("curriculum_id")

  // Relations
  studentRecords   StudentRecord[]
  gradeAttempts    GradeAttempt[]
  ratings          CourseRating[]
  ratingWriteLimit RatingWriteLimit?
  studyPlans       StudyPlan[]
  updatedResources SchoolResource[]
  allocationRuns   SimulationAllocationRun[]
  allocationJobs   SimulationAllocationJob[]
  curriculum       Curriculum?               @relation(fields: [curriculumId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([email])
  @@index([curriculumId])
  @@map("users")
}

// Immutable aggregate experiments only; no student assignment or registration job.
model SimulationAllocationRun {
  id            String   @id @default(uuid())
  curriculumId  String   @map("curriculum_id")
  semester      Semester
  year          Int
  jobId         String?  @unique @map("job_id")
  requestId     String   @map("request_id")
  createdById   String?  @map("created_by_id")
  formatVersion Int      @default(1) @map("format_version")
  capturedAt    DateTime @map("captured_at")
  createdAt     DateTime @default(now()) @map("created_at")
  result        Json

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy  User?      @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Restrict)

  execution SimulationAllocationExecution?
  job       SimulationAllocationJob?       @relation("AllocationJobCapture", fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([createdById, requestId])
  @@index([curriculumId, semester, year, createdAt])
  @@map("simulation_allocation_runs")
}

// Immutable queue requests only; inputs have not been captured and no executor exists yet.
model SimulationAllocationJob {
  id           String   @id @default(uuid())
  curriculumId String   @map("curriculum_id")
  semester     Semester
  year         Int
  createdById  String?  @map("created_by_id")
  requestId    String   @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy  User?      @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Restrict)

  execution SimulationAllocationExecution?
  run       SimulationAllocationRun?       @relation("AllocationJobCapture")

  @@unique([createdById, requestId])
  @@index([curriculumId, semester, year, createdAt], map: "simulation_allocation_jobs_curriculum_id_semester_year_created_")
  @@map("simulation_allocation_jobs")
}

enum SimulationAllocationExecutionStatus {
  SUCCEEDED
  FAILED
}

// The terminal outcome commits atomically with its aggregate run, if one was captured.
model SimulationAllocationExecution {
  jobId       String                              @id @map("job_id")
  status      SimulationAllocationExecutionStatus
  runId       String?                             @unique @map("run_id")
  failureCode String?                             @map("failure_code")
  completedAt DateTime                            @map("completed_at")

  job SimulationAllocationJob  @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  run SimulationAllocationRun? @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("simulation_allocation_executions")
}

model StudentRecord {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  courseId      String       @map("course_id")
  grade         String? // e.g., "A", "B+", "C"
  gradePoints   Float?       @map("grade_points")
  semester      String? // e.g., "Fall 2023"
  year          Int?
  status        CourseStatus @default(COMPLETED)
  electiveGroup String?      @map("elective_group")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("student_records")
}

model GradeAttempt {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  courseId  String    @map("course_id")
  requestId String    @map("request_id") @db.Uuid
  score     Float
  semester  Semester?
  year      Int?
  createdAt DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([courseId])
  @@map("grade_attempts")
}

model CourseRating {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  rating    Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_ratings")
}

model RatingWriteLimit {
  userId      String   @id @map("user_id")
  windowStart DateTime @map("window_start")
  writeCount  Int      @default(0) @map("write_count")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("rating_write_limits")
}

model StudyPlan {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  // Relations
  semesters PlannedSemester[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("study_plans")
}

model PlannedSemester {
  id          String   @id @default(uuid())
  studyPlanId String   @map("study_plan_id")
  semester    Semester
  year        Int

  // JSON field to store course IDs and their positions
  courses Json // Array of { courseId: string, position: number }

  totalCredits    Int    @default(0) @map("total_credits")
  difficultyScore Float? @map("difficulty_score")

  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studyPlanId, semester, year])
  @@index([studyPlanId])
  @@map("planned_semesters")
}

enum CourseCategory {
  REQUIRED
  ELECTIVE
  CORE
  MAJOR_ELECTIVE
  GENERAL_EDUCATION
  FREE_ELECTIVE
}

enum UserRole {
  STUDENT
  ADMIN
}

enum Semester {
  FALL
  SPRING
  SUMMER
}

enum CourseStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  FAILED
  DROPPED
}
