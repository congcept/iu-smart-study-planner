DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iu_study_planner
PORT=3001
NODE_ENV=development
# Quick demo sessions are development-only. Set false to hide/disable them locally.
DEMO_LOGIN_ENABLED=true
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your-secret-key

# Maximum changed difficulty votes per account in a UTC clock hour (1–10000)
RATING_WRITES_PER_HOUR=60

# Semester difficulty penalty per point above 1 (0 disables, maximum 50)
SEMESTER_DIFFICULTY_PENALTY_WEIGHT=10

# Maximum recommendation bonus from highest numeric grades (0 disables, maximum 20)
RECOMMENDATION_GRADE_FIT_WEIGHT=2
# Eligible history must share course category and be within this rating difficulty (0–4)
RECOMMENDATION_GRADE_DIFFICULTY_TOLERANCE=0.5

# Abstract classroom-section opportunities, not hours or a verified semester calendar (0–100).
# Every section uses one whole block and one interchangeable professor in this simulation only.
# These assumptions affect the resource-envelope diagnostic; they do not change recommendations.
SIMULATION_CLASSROOM_TIME_BLOCKS=1
# Maximum sections per professor across those blocks (0–100; concurrency is capped by blocks).
SIMULATION_SECTIONS_PER_PROFESSOR=1
