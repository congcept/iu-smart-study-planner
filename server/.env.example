DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iu_study_planner
PORT=3001
NODE_ENV=development
# Quick demo sessions are development-only. Set false to hide/disable them locally.
DEMO_LOGIN_ENABLED=true
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your-secret-key

# Maximum changed difficulty votes per account in a UTC clock hour (1–10000)
RATING_WRITES_PER_HOUR=60

# Semester difficulty penalty per point above 1 (0 disables, maximum 50)
SEMESTER_DIFFICULTY_PENALTY_WEIGHT=10
